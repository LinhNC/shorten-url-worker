{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rut-gon",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
